{
  "name": "returnet-workspace",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "web:dev": "pnpm --dir apps/web dev",
    "web:build": "pnpm --dir apps/web build",
    "web:test": "pnpm --dir apps/web test",
    "mobile:start": "pnpm --dir apps/mobile start",
    "mobile:test": "pnpm --dir apps/mobile test",
    "infra:synth": "pnpm --dir infra/cdk synth",
    "check": "pnpm --dir apps/web check && pnpm --dir apps/mobile check && pnpm --dir infra/cdk check"
  }
}
